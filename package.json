{
  "name": "ade",
  "description": "Vade desktop agent development environment",
  "main": "desktop/main.cjs",
  "version": "0.1.12",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "start": "tsx server/index.ts",
    "build:desktop": "npm run build && node scripts/build-desktop.mjs",
    "desktop": "npm run build:desktop && electron .",
    "package:desktop": "npm run build:desktop && node scripts/package-desktop.mjs",
    "package:release": "npm run build:desktop && node scripts/package-desktop.mjs --release",
    "test": "node --import tsx --test server/http/speechRoutes.test.ts src/tests/localDictation.test.ts src/tests/modalScrollLock.test.ts src/tests/terminalSurface.test.ts server/http/terminalViewports.test.ts src/tests/terminalTouch.test.ts server/http/phoneOrigin.test.ts src/tests/conversationEvents.test.ts src/tests/dictation.test.ts src/tests/kanban.test.ts src/tests/inbox.test.ts src/tests/github.test.ts src/tests/notifications.test.ts src/tests/notificationClient.test.ts src/tests/workflow.test.ts src/tests/dialogsAndUi.test.ts server/integrations/cli.test.ts server/integrations/github.test.ts server/integrations/githubAccounts.test.ts server/providers/transcripts.test.ts server/services/progress.test.ts server/services/attachments.test.ts src/tests/commitGraph.test.ts server/runtime/localRuntime.test.ts server/runtime/connections.test.ts server/runtime/notificationState.test.ts server/runtime/dsh.test.ts server/runtime/sessionHandoff.test.ts server/runtime/providerAccounts.test.ts server/runtime/agentHistory.test.ts server/runtime/organization.test.ts server/runtime/providerChatControls.test.ts server/runtime/speech.test.ts server/providers/transcriptUtils.test.ts server/providers/contextUsage.test.ts server/runtime/providerContext.test.ts"
  },
  "build": {
    "appId": "dev.ade.desktop",
    "productName": "Vade",
    "icon": "resources/branding/vade.png",
    "publish": {
      "provider": "github",
      "owner": "Haojerh",
      "repo": "ADE",
      "releaseType": "release"
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**",
      "resources/branding/**",
      "build/server.cjs",
      "build/ptyHost.cjs",
      "build/speechWorker.cjs",
      "build/orchestration/**",
      "dist/**",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**",
      "node_modules/sherpa-onnx-*/**",
      "build/ptyHost.cjs",
      "build/speechWorker.cjs"
    ],
    "npmRebuild": false,
    "win": {
      "target": "nsis",
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "icon": "resources/branding/vade.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "resources/branding/vade.ico",
      "uninstallerIcon": "resources/branding/vade.ico",
      "shortcutName": "Vade",
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "uninstallDisplayName": "Vade"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ]
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "dependencies": {
    "@tiptap/extension-image": "^3.32.0",
    "@tiptap/extension-table": "^3.32.0",
    "@tiptap/extension-task-item": "^3.32.0",
    "@tiptap/extension-task-list": "^3.32.0",
    "@tiptap/markdown": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/headless": "^6.0.0",
    "@xterm/xterm": "^6.0.0",
    "electron-updater": "^6.8.9",
    "lucide-react": "^1.61.0",
    "monaco-editor": "^0.57.0",
    "node-pty": "^1.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tsx": "^4.19.2",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "electron": "^44.9.3",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  },
  "optionalDependencies": {
    "sherpa-onnx-darwin-arm64": "^1.12.37",
    "sherpa-onnx-darwin-x64": "^1.12.37",
    "sherpa-onnx-linux-arm64": "^1.12.37",
    "sherpa-onnx-linux-x64": "^1.12.37",
    "sherpa-onnx-win-x64": "^1.12.37"
  }
}
